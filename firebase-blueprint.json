{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Catalog product displayed in Elza Shop",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Display name of the product",
          "minLength": 1,
          "maxLength": 80
        },
        "subtitle": {
          "type": "string",
          "description": "Optional short description of the product",
          "maxLength": 140
        },
        "price": {
          "type": "number",
          "description": "Product price in currency units"
        },
        "currency": {
          "type": "string",
          "description": "Currency label such as грн",
          "minLength": 1,
          "maxLength": 16
        },
        "image": {
          "type": "string",
          "description": "Product image URL, asset path, or compressed raster data URI",
          "minLength": 1,
          "maxLength": 450000
        },
        "rarities": {
          "type": "array",
          "description": "Optional rarity and potion badges (M, N, F, R)"
        },
        "sortOrder": {
          "type": "number",
          "description": "Numeric sort order in the catalog grid"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the product is visible in the public catalog"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the anonymous admin session that created the product",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "title",
        "price",
        "currency",
        "image",
        "sortOrder",
        "isPublished",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Salted PBKDF2 admin password configuration stored in Firestore",
      "type": "object",
      "properties": {
        "salt": {
          "type": "string",
          "description": "Random hex salt",
          "minLength": 8,
          "maxLength": 128
        },
        "passwordHash": {
          "type": "string",
          "description": "PBKDF2-SHA256 hex digest",
          "minLength": 32,
          "maxLength": 256
        },
        "algorithm": {
          "type": "string",
          "description": "Hash algorithm identifier",
          "maxLength": 32
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of the session that updated the config",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when config was updated"
        }
      },
      "required": ["salt", "passwordHash", "algorithm", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Publicly readable catalog products managed via admin panel"
    },
    "/app_config/{docId}": {
      "schema": { "$ref": "#/entities/AdminConfig" },
      "description": "Salted admin passcode hash configuration"
    }
  }
}
